# DB Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ragplatform
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Django Settings
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# S3 Configuration (Local/Mock)
# Set USE_MOCK_STORAGE=True to use local disk instead of S3
USE_MOCK_STORAGE=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# AI Provider Configuration
# Set USE_MOCK_LLM=True for local testing
USE_MOCK_LLM=True
LLM_PROVIDER=mock
# e.g., openai, anthropic
OPENAI_API_KEY=
